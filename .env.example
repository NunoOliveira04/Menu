# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Alternativa suportada (Supabase Publishable Key mais recente):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL público base da aplicação (links, QR e redirect de confirmação de email para /admin).
# Demo: https://menu-drab-psi.vercel.app
# No Supabase → Authentication → URL Configuration, o allow-list tem de cobrir:
#   https://menu-drab-psi.vercel.app/admin/**
#   http://localhost:3000/admin/**
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subdomínios por restaurante (opcional — desligado por defeito)
# Quando ENABLE_SUBDOMAIN_ROUTING=true e ROOT_DOMAIN=menudigital.pt,
# pedidos para https://menu-restaurante.menudigital.pt são reescritos para /r/menu-restaurante
ENABLE_SUBDOMAIN_ROUTING=false
ROOT_DOMAIN=localhost:3000
